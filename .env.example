# Password required by the hidden update form at /form
FORM_PASSWORD=change-me

# Fine-grained GitHub token with "Contents: read and write" on this repository.
# Used server-side by /api/swim to commit new swims to data/swim-log.json.
DATA_GITHUB_TOKEN=

# Optional overrides (defaults shown)
# DATA_REPO=JamieMBright/charity-swim
# DATA_BRANCH=main

# Optional override for the JustGiving page slug used by the scraper
# JUSTGIVING_PAGE_SLUG=karen-elaine-22-miles
